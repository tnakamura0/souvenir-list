<div class="mb-6">
  <%= link_to recipients_path, class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="mb-6 flex gap-1 md:gap-3">
  <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary">
    <span class="material-symbols-rounded">emoji_people</span>
  </div>
  <div>
    <h1 class="page-title"><%= t(".title") %></h1>
    <p class="page-description"><%= t(".description") %></p>
  </div>
</div>
<div class="card p-5 md:p-6">
  <%= render "form", recipient: @recipient, cancel_path: recipients_path %>
</div>
