<div class="
  flex items-start justify-between gap-4
  rounded-3xl border border-mist-100 bg-white p-5 shadow-md
  transition
  hover:border-mist-200 hover:bg-mist-50
">
  <div class="min-w-0 flex-1">
    <%= render(
          "shared/recipient_summary",
          recipient: recipient
        ) %>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <%= link_to t("common.edit"),
                edit_recipient_path(recipient),
                class: "
                  rounded-xl border border-mist-200
                  px-3 py-1.5 text-xs text-mist-400
                  hover:border-mist-300 hover:text-mist-700
                " %>

    <%= button_to t("common.delete"),
                  recipient_path(recipient),
                  method: :delete,
                  data: {
                    turbo_confirm: t(
                      "recipients.recipient.delete_confirmation",
                      recipient_name: recipient.name
                    )
                  },
                  class: "
                    rounded-xl border border-red-100
                    px-3 py-1.5 text-xs text-red-400
                    hover:border-red-200 hover:text-red-600
                  " %>
  </div>
</div>
