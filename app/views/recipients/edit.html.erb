<div class="mb-6">
  <%= link_to recipient_path(@recipient), class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="flex mb-6 gap-3">
  <div class="flex items-center justify-center size-12 shrink-0 rounded-xl bg-primary-soft text-primary">
    <span class="material-symbols-rounded">emoji_people</span>
  </div>
  <div>
    <h1 class="page-title"><%= t(".title") %></h1>
    <p class="page-description"><%= t(".description") %></p>
  </div>
</div>

<div class="card p-5 md:p-6">
  <%= render "form", recipient: @recipient, cancel_path: recipient_path(@recipient) %>
</div>
