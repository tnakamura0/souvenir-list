<%= form_with model: @recipient, class: "space-y-5", data: { controller: "people-count-toggle" } do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <%# 名前 %>
  <div>
    <%= f.label :name, t("recipients.form.name.label"), class: "block mb-1" %>
    <%= f.text_field :name, placeholder: t("recipients.form.name.placeholder"), class: "w-full px-4 py-3 border border-mist-200 rounded focus:border-2 focus:border-mist-400" %>
  </div>

  <%# 種別 %>
  <p class=" mb-2"><%= t("recipients.form.kind.label") %></p>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.radio_button :kind,
                        "individual",
                        class: "peer sr-only",
                        data: {
                          action: "change->people-count-toggle#toggle",
                        }
      %>
      <%= f.label :kind_individual, t("recipients.form.kind.individual"), class: "flex cursor-pointer items-center justify-center rounded-xl border border-mist-300 px-4 py-3 text-sm font-medium text-mist-700 transition peer-checked:border-mist-600 peer-checked:bg-mist-300" %>
    </div>

    <div>
      <%= f.radio_button :kind,
                        "group",
                        class: "peer sr-only",
                        data: {
                          action: "change->people-count-toggle#toggle",
                          people_count_toggle_target: "groupRadio"
                        }
      %>
      <%= f.label :kind_group, t("recipients.form.kind.group"), class: "flex cursor-pointer items-center justify-center rounded-xl border border-mist-300 px-4 py-3 text-sm font-medium text-mist-700 transition peer-checked:border-mist-600 peer-checked:bg-mist-300" %>
    </div>
  </div>

  <%# グループの人数 %>
  <div class="hidden" data-people-count-toggle-target="field">
    <%= f.label :people_count, t("recipients.form.people_count.label"), class: "block mb-1" %>
    <%= f.number_field :people_count,
                      placeholder: t("recipients.form.people_count.placeholder"),
                      min: 2,
                      step: 1,
                      class: "w-full px-4 py-3 border border-mist-200 rounded focus:border-2 focus:border-mist-400",
                      data: { people_count_toggle_target: "input" }
    %>
  </div>

  <%# メモ %>
  <div>
    <%= f.label :memo, t("recipients.form.memo.label"), class: "block mb-1" %>
    <%= f.textarea :memo, placeholder: t("recipients.form.memo.placeholder"), class: "w-full border border-mist-200 rounded px-4 py-3 focus:border-2 focus:border-mist-400" %>
  </div>

  <%# タグ関連 %>
  <%# 既存タグ一覧表示 %>
  <div>
    <p class="mb-2 block">
      <%= t("recipients.form.tags.label") %>
    </p>

    <% if @tags.present? %>
      <div class="flex flex-wrap gap-2">
        <%= f.collection_check_boxes :tag_ids, @tags, :id, :name do |tag| %>
          <%= tag.label class: "cursor-pointer" do %>
            <%= tag.check_box class: "peer sr-only" %>

            <span
              class="
                inline-flex rounded-full border border-mist-200
                px-3 py-1.5 text-sm text-mist-600
                transition
                hover:border-mist-400
                peer-checked:border-mist-600
                peer-checked:bg-mist-600
                peer-checked:text-white
                peer-focus-visible:ring-2
                peer-focus-visible:ring-mist-500
                peer-focus-visible:ring-offset-2
              "
            >
              <%= tag.text %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-mist-500">
        <%= t("recipients.form.tags.empty") %>
      </p>
    <% end %>
  </div>

  <%# タグ新規作成フォーム %>
  <div>
    <%= f.text_field :new_tag_name,
                    placeholder: t("recipients.form.new_tag_name.placeholder"),
                    class: "
                      w-full rounded border border-mist-200
                      px-4 py-3 text-sm
                      focus:border-mist-400 focus:ring-mist-400
                    " %>

    <p class="mt-1 text-sm text-mist-500">
      <%= t("recipients.form.new_tag_name.description") %>
    </p>
  </div>

  <%# 登録・キャンセルボタン %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <%= f.submit class: "font-medium text-white bg-mist-600 block w-full px-4 py-3 border border-mist-500 rounded-2xl" %>
    <%= link_to t("recipients.form.cancel"), cancel_path, class: "font-medium text-center px-4 py-3 border border-mist-400 rounded-2xl" %>
  </div>
<% end %>
