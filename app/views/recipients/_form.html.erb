<%= form_with model: @recipient, class: "space-y-5", data: { controller: "people-count-toggle" } do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <%# 名前 %>
  <div>
    <%= f.label :name, class: "label flex items-center gap-2" do %>
      <span><%= t("recipients.form.name.label") %></span>
      <span class="rounded bg-danger-soft px-1.5 py-0.5 text-xs font-medium text-danger">
        <%= t("common.required") %>
      </span>
    <% end %>
    <%= f.text_field :name, placeholder: t("recipients.form.name.placeholder"), class: "form-control #{'input-error' if @recipient.errors[:name].present?}" %>
  </div>

  <%# 種別 %>
  <fieldset>
    <legend class="label"><%= t("recipients.form.kind.label") %></legend>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.radio_button :kind,
                          "individual",
                          class: "peer sr-only",
                          data: {
                            action: "change->people-count-toggle#toggle",
                          }
        %>
        <%= f.label :kind_individual, class: "flex cursor-pointer items-center justify-center gap-1.5 px-4 py-3 rounded-xl border border-border text-text-secondary font-medium transition hover:border-primary peer-checked:border-primary peer-checked:bg-primary-soft peer-focus-visible:ring-2 peer-focus-visible:ring-primary peer-focus-visible:ring-offset-2" do %>
          <span class="material-symbols-rounded">person</span>
          <span><%= t("recipients.form.kind.individual") %></span>
        <% end %>
      </div>

      <div>
        <%= f.radio_button :kind,
                          "group",
                          class: "peer sr-only",
                          data: {
                            action: "change->people-count-toggle#toggle",
                            people_count_toggle_target: "groupRadio"
                          }
        %>
        <%= f.label :kind_group, class: "flex cursor-pointer items-center justify-center gap-1.5 px-4 py-3 rounded-xl border border-border text-text-secondary font-medium transition hover:border-primary peer-checked:border-primary peer-checked:bg-primary-soft peer-focus-visible:ring-2 peer-focus-visible:ring-primary peer-focus-visible:ring-offset-2" do %>
          <span class="material-symbols-rounded">group</span>
          <span><%= t("recipients.form.kind.group") %></span>
        <% end %>
      </div>
    </div>
  </fieldset>

  <%# グループの人数 %>
  <div class="hidden" data-people-count-toggle-target="field">
    <%= f.label :people_count, class: "label flex items-center gap-2" do %>
      <span><%= t("recipients.form.people_count.label") %></span>
      <span class="rounded bg-danger-soft px-1.5 py-0.5 text-xs font-medium text-danger">
        <%= t("common.required") %>
      </span>
    <% end %>
    <%= f.number_field :people_count,
                      placeholder: t("recipients.form.people_count.placeholder"),
                      min: 2,
                      step: 1,
                      class: "form-control #{'input-error' if @recipient.errors[:people_count].present?}",
                      data: { people_count_toggle_target: "input" }
    %>
  </div>

  <%# メモ %>
  <div>
    <%= f.label :memo, t("recipients.form.memo.label"), class: "label" %>
    <%= f.textarea :memo, placeholder: t("recipients.form.memo.placeholder"), class: "form-control min-h-28 resize-y" %>
  </div>

  <%# タグ関連 %>
  <%# 既存タグ一覧表示 %>
  <div>
    <p class="mb-2 block"><%= t("recipients.form.tags.label") %></p>

    <% if @tags.present? %>
      <div class="flex flex-wrap gap-2">
        <%= f.collection_check_boxes :tag_ids, @tags, :id, :name do |tag| %>
          <%= tag.label class: "cursor-pointer" do %>
            <%= tag.check_box class: "peer sr-only" %>

            <span
              class="
                inline-flex rounded-full border border-border
                px-3 py-1.5 text-sm
                transition
                hover:border-primary
                peer-checked:bg-primary
                peer-checked:text-text-inverse
                peer-focus-visible:ring-2
                peer-focus-visible:ring-primary
                peer-focus-visible:ring-offset-2
              "
            >
              <%= tag.text %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-text-secondary">
        <%= t("recipients.form.tags.empty") %>
      </p>
    <% end %>
  </div>

  <%# タグ新規作成フォーム %>
  <div>
    <%= f.text_field :new_tag_name,
                    placeholder: t("recipients.form.new_tag_name.placeholder"),
                    class: "form-control" %>
    <p class="mt-1 text-sm text-text-muted">
      <%= t("recipients.form.new_tag_name.description") %>
    </p>
  </div>

  <%# 登録・キャンセルボタン %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <%= link_to t("recipients.form.cancel"), cancel_path, class: "btn-secondary text-center" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
