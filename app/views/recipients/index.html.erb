<div class="mb-6 flex items-center justify-between">
  <h1 class="page-title"><%= t(".title") %></h1>
  <%= link_to new_recipient_path, class: "flex items-center gap-1.5 btn-secondary" do %>
    <span class="material-symbols-rounded">add</span>
    <span><%= t(".new_recipient") %></span>
  <% end %>
</div>

<%# タグ関係 %>
<div class="card mb-6 p-4">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="font-medium"><%= t(".tag_filter.title") %></h2>

    <%= link_to tags_path,
                class: "inline-flex shrink-0 items-center gap-1 text-sm text-secondary hover:text-primary" do %>
      <span><%= t(".manage_tags") %></span>
      <span class="material-symbols-rounded">chevron_forward</span>
    <% end %>
  </div>

  <%= form_with url: recipients_path, method: :get do |f| %>
    <div class="flex items-end gap-2">
      <div class="min-w-0 flex-1">
        <%= f.collection_select :tag_id,
                                @tags,
                                :id,
                                :name,
                                {
                                  include_blank: t(".tag_filter.all"),
                                  selected: @selected_tag&.id
                                },
                                class: "select" %>
      </div>

      <%= f.submit t(".tag_filter.submit"), class: "shrink-0 btn-secondary" %>
    </div>
  <% end %>
</div>

<% if @recipients.present? %>
  <div class="space-y-3">
    <%= render @recipients %>
  </div>
<% else %>
  <%# 相手を1つも作成していない場合の表示 %>
  <div class="card py-10 text-center">
    <p class="mb-2 font-medium"><%= t(".empty.title") %></p>
    <p class="mb-6 text-sm text-text-secondary"><%= t(".empty.description") %></p>
    <%= link_to new_recipient_path, class: "btn-primary inline-flex items-center gap-2 px-6 py-3" do %>
      <span class="material-symbols-rounded">person_add</span>
      <span><%= t(".empty.action") %></span>
    <% end %>
  </div>
<% end %>
