<% content_for :hide_bottom_navigation, true %>
<% content_for :hide_footer, true %>

<div class="mb-6">
  <%= link_to trip_path(@trip), class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="mb-6">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="page-description"><%= t(".description", trip_name: @trip.name) %></p>
</div>

<%= form_with url: new_trip_trip_recipient_path(@trip), method: :get, class: "mb-4" do |f| %>
  <div class="flex items-end gap-2">
    <div class="min-w-0 flex-1">
      <%= f.collection_select :tag_id,
                              @tags,
                              :id,
                              :name,
                              {
                                include_blank: t(".tag_filter.all"),
                                selected: @selected_tag&.id
                              },
                              class: "select" %>
    </div>
    <%= f.submit t(".tag_filter.submit"), class: "btn-secondary shrink-0" %>
  </div>
<% end %>

<% if @recipients.present? %>
  <%= form_with url: trip_trip_recipients_path(@trip),
                data: { controller: "recipient-selection" },
                class: "md:pb-4" do %>

    <div class="mb-4 flex items-center justify-between">
      <p class="text-text-secondary">
        <%= t(".recipient_count", count: @recipients.size) %>
      </p>

      <% if @recipients.present? %>
        <button
          type="button"
          class="btn-secondary px-3"
          data-action="recipient-selection#selectAll"
        >
          <%= t(".select_all", count: @recipients.size) %>
        </button>
      <% end %>
    </div>

    <div class="space-y-3">
      <%= render partial: "selectable_recipient",
                   collection: @recipients,
                   as: :recipient %>
    </div>

    <div
      class="
        fixed inset-x-0 bottom-0 z-20
        border-t border-border bg-surface
        px-4 py-3
        md:static md:border-0 md:bg-transparent md:px-0
      "
    >
      <div class="mx-auto max-w-3xl">
        <p class="mb-2 text-center">
          <span
            class="font-bold text-xl"
            data-recipient-selection-target="selectedCount"
          >
            0
          </span>
          <span class="text-lg"><%= t(".selected_count") %></span>
        </p>

        <div class="flex gap-3">
          <%= link_to t("common.cancel"),
                      trip_path(@trip),
                      class: "
                        flex-1 btn-secondary text-center
                      " %>

          <%= submit_tag t(".submit"),
                        disabled: true,
                        data: {
                          recipient_selection_target: "submit"
                        },
                        class: "
                          flex-1 btn-primary
                          disabled:cursor-not-allowed
                          disabled:opacity-50
                        " %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="card p-6 text-center">
    <p class="mb-4 font-medium"><%= t(".empty.message") %></p>
    <%= link_to new_recipient_path, class: "btn-secondary inline-flex items-center gap-2" do %>
      <span class="material-symbols-rounded">person_add</span>
      <span><%= t(".empty.action") %></span>
    <% end %>
  </div>
<% end %>
