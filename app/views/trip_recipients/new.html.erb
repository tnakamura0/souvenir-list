<% content_for :hide_bottom_navigation, true %>
<% content_for :hide_footer, true %>

<div class="mb-6">
  <%= link_to trip_path(@trip), class: "inline-flex items-center gap-1 text-sm text-mist-400 hover:text-mist-700" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="mb-6">
  <h1 class="font-bold text-2xl"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-mist-500"><%= t(".description", trip_name: @trip.name) %></p>
</div>

<%= form_with url: new_trip_trip_recipient_path(@trip), method: :get, class: "mb-4" do |f| %>
  <div class="flex items-end gap-2">
    <div class="min-w-0 flex-1">
      <%= f.collection_select :tag_id,
                              @tags,
                              :id,
                              :name,
                              {
                                include_blank: t(".tag_filter.all"),
                                selected: @selected_tag&.id
                              },
                              class: "w-full border border-mist-200 px-3 py-2" %>
    </div>
    <%= f.submit t(".tag_filter.submit"), class: "shrink-0 rounded-xl bg-mist-600 px-4 py-2 text-white" %>
  </div>
<% end %>

<% if @recipients.present? %>
  <%= form_with url: trip_trip_recipients_path(@trip),
                data: { controller: "recipient-selection" },
                class: "md:pb-4" do %>

    <div class="mb-4 flex items-center justify-between">
      <p class="text-sm text-mist-500">
        <%= t(".recipient_count", count: @recipients.size) %>
      </p>

      <% if @recipients.present? %>
        <button
          type="button"
          class="rounded-xl border border-mist-300 px-3 py-2 text-sm text-mist-700 hover:bg-mist-100 hover:border-mist-500"
          data-action="recipient-selection#selectAll"
        >
          <%= t(".select_all", count: @recipients.size) %>
        </button>
      <% end %>
    </div>

    <div class="space-y-3">
      <%= render partial: "selectable_recipient",
                   collection: @recipients,
                   as: :recipient %>
    </div>

    <div
      class="
        fixed inset-x-0 bottom-0 z-20
        border-t border-mist-200 bg-white
        px-4 py-3
        md:static md:mt-6 md:border-0 md:bg-transparent md:px-0
      "
    >
      <div class="mx-auto max-w-3xl">
        <p class="mb-2 text-center text-sm text-mist-600">
          <span
            class="font-bold text-mist-900"
            data-recipient-selection-target="selectedCount"
          >
            0
          </span>
          <%= t(".selected_count_prefix") %>
          <%= t(".selected_count_suffix") %>
        </p>

        <div class="flex gap-3">
          <%= link_to t("common.cancel"),
                      trip_path(@trip),
                      class: "
                        flex-1 rounded-xl border border-mist-300
                        px-4 py-3 text-center text-sm text-mist-700
                      " %>

          <%= submit_tag t(".submit"),
                        disabled: true,
                        data: {
                          recipient_selection_target: "submit"
                        },
                        class: "
                          flex-1 rounded-xl bg-mist-600 px-4 py-3
                          text-sm font-medium text-white
                          disabled:cursor-not-allowed
                          disabled:bg-mist-300
                        " %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="rounded-xl border border-mist-200 bg-white p-6 text-center">
    <p class="text-sm text-mist-600"><%= t(".empty") %></p>
  </div>
<% end %>
