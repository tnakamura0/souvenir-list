<div class="mb-6">
  <%= link_to trip_path(@trip), class: "inline-flex items-center gap-1 text-sm text-mist-400 hover:text-mist-700" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="mb-6">
  <h1 class="font-bold text-2xl"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-mist-500"><%= t(".description", trip_name: @trip.name) %></p>
</div>

<% if @recipients.present? %>
  <%= form_with url: trip_trip_recipients_path(@trip) do %>
    <div class="space-y-3">
      <%= render partial: "selectable_recipient",
                   collection: @recipients,
                   as: :recipient %>
    </div>
    <div class="mt-6">
      <%= submit_tag t(".submit"),
                       class: "w-full rounded-xl bg-mist-600 px-4 py-3 text-sm font-medium text-white hover:bg-mist-700" %>
    </div>
  <% end %>
<% else %>
  <div class="rounded-xl border border-mist-200 bg-white p-6 text-center">
    <p class="text-sm text-mist-600"><%= t(".empty") %></p>
  </div>
<% end %>
