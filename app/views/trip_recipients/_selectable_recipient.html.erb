<label class="block cursor-pointer">
  <%= check_box_tag "recipient_ids[]",
                    recipient.id,
                    false,
                    class: "peer sr-only" %>

  <div
    class="
      relative flex items-center gap-3 rounded-xl
      border border-mist-200 bg-white p-4
      transition
      hover:border-mist-400
      peer-checked:border-mist-600
      peer-checked:bg-mist-50
      peer-checked:ring-1
      peer-checked:ring-mist-600
      peer-focus-visible:ring-2
      peer-focus-visible:ring-mist-500
      peer-focus-visible:ring-offset-2
    "
  >
    <div class="min-w-0 flex-1">
      <%= render(
            "shared/recipient_summary",
            recipient: recipient
          ) %>
    </div>
  </div>
</label>
