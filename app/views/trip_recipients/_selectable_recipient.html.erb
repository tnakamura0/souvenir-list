<label class="block cursor-pointer">
  <%= check_box_tag "recipient_ids[]",
                    recipient.id,
                    false,
                    id: "recipient_#{recipient.id}",
                    class: "peer sr-only",
                    data: {
                      recipient_selection_target: "checkbox",
                      action: "change->recipient-selection#update"
                    } %>

  <div
    class="
      relative flex items-center gap-3 rounded-xl
      border border-border bg-surface p-4
      transition-colors duration-200
      hover:border-primary
      peer-checked:border-primary
      peer-checked:bg-primary-soft
      peer-checked:ring-1
      peer-checked:ring-primary
      peer-focus-visible:ring-2
      peer-focus-visible:ring-primary
      peer-focus-visible:ring-offset-2
    "
  >
    <div class="min-w-0 flex-1">
      <%= render(
            "shared/recipient_summary",
            recipient: recipient
          ) %>
    </div>
  </div>
</label>
