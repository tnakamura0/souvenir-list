<div id="<%= dom_id(trip_recipient) %>" class="card p-4" data-controller="modal">
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0 flex-1">
      <%= render(
            "shared/recipient_summary",
            recipient: trip_recipient.recipient,
            show_memo: false
          ) %>

      <% if trip_recipient.souvenir_name.present? %>
        <div class="mt-2 flex min-w-0 items-center gap-1.5 text-sm text-text-secondary">
          <span class="material-symbols-rounded shrink-0 text-accent text-[18px]!">
            shopping_bag
          </span>
          <span class="truncate font-medium">
            <%= trip_recipient.souvenir_name %>
          </span>
        </div>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-1">
      <%= button_to trip_trip_recipient_path(trip_recipient.trip, trip_recipient),
                    method: :patch,
                    params: {
                      trip_recipient: {
                        purchased: !trip_recipient.purchased?
                      }
                    },
                    class: class_names(
                      "inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm transition-colors",
                      {
                        "text-success" => trip_recipient.purchased?,
                        "text-text-secondary hover:text-primary" => !trip_recipient.purchased?
                      }
                    ) do %>
        <span class="material-symbols-rounded text-[20px]!">
          <%= trip_recipient.purchased? ? "check_circle" : "radio_button_unchecked" %>
        </span>

        <span>
          <%= trip_recipient.purchased? ?
                t("trips.show.recipients.purchased") :
                t("trips.show.recipients.not_purchased") %>
        </span>
      <% end %>

      <div class="relative" data-controller="kebab-menu" data-action="click@window->kebab-menu#closeOnOutside">
        <button
          type="button"
          class="
            inline-flex items-center justify-center
            rounded-lg p-2
            text-text-muted
            transition-colors
            hover:text-text-primary
          "
          data-action="click->kebab-menu#toggle"
        >
          <span class="material-symbols-rounded">more_vert</span>

          <span class="sr-only">
            <%= t("trips.show.recipients.menu.open") %>
          </span>
        </button>

        <div
          class="absolute right-0 top-full z-20 mt-1 hidden w-40 rounded-lg border border-border bg-surface p-1 shadow-lg"
          data-kebab-menu-target="menu"
        >
          <button
            type="button"
            class="w-full rounded-md px-3 py-2 text-left text-sm hover:bg-surface-hover"
            data-action="click->kebab-menu#close click->modal#open"
          >
            <%= t("trips.show.recipients.menu.add_souvenir") %>
          </button>

          <%= button_to trip_trip_recipient_path(trip_recipient.trip, trip_recipient),
                        method: :delete,
                        data: {
                          turbo_confirm: t(
                            "trips.show.recipients.remove_confirmation",
                            recipient_name: trip_recipient.recipient.name
                          )
                        },
                        class: "w-full rounded-md px-3 py-2 text-left text-sm text-danger hover:bg-danger-soft" do %>
            <%= t("trips.show.recipients.remove") %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render "trip_recipients/souvenir_modal", trip_recipient: trip_recipient %>
</div>
