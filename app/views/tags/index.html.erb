<div class="mb-6">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-mist-400 hover:text-mist-700" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div>
  <div class="mb-6">
    <h1 class="font-bold text-xl mb-1"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-mist-500"><%= t(".description") %></p>
  </div>

  <%# タグ作成フォーム %>
  <%= form_with model: @tag, class: "mb-5" do |f| %>
    <div class="flex w-full">
      <%= f.text_field :name, placeholder: t("tags.form.name.placeholder"), class: "flex-1 px-4 py-3 border border-mist-200 rounded focus:border-2 focus:border-mist-400" %>

      <%= f.submit t("tags.form.create"), class: "ml-2 px-4 py-1.5 text-white bg-mist-500 rounded-xl" %>
    </div>
  <% end %>

  <%# タグ一覧表示 %>
  <% if @tags.present? %>
    <div class="space-y-3">
      <%= render @tags %>
    </div>
  <% else %>
    <p class="font-medium text-mist-500"><%= t(".empty.message") %></p>
  <% end %>
</div>
