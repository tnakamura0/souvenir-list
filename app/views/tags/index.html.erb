<div class="mb-6">
  <%= link_to recipients_path, class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div>
  <div class="mb-6">
    <h1 class="page-header page-title"><%= t(".title") %></h1>
    <p class="page-description"><%= t(".description") %></p>
  </div>

  <%# タグ作成フォーム %>
  <%= form_with model: @tag, class: "mb-5" do |f| %>
    <div class="flex w-full items-stretch">
      <div class="min-w-0 flex-1">
        <%= f.text_field :name, placeholder: t("tags.form.name.placeholder"), class: "form-control" %>
      </div>

      <%= f.submit class: "ml-2 shrink-0 btn-secondary" %>
    </div>
  <% end %>

  <%# タグ一覧表示 %>
  <% if @tags.present? %>
    <div class="space-y-3">
      <%= render @tags %>
    </div>
  <% else %>
    <p class="font-medium text-text-secondary text-center"><%= t(".empty.message") %></p>
  <% end %>
</div>
