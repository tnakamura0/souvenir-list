<%= form_with model: tag, class: "space-y-3 rounded-3xl border border-mist-200 bg-white p-3 shadow-sm" do |f| %>
  <%= render "shared/error_messages", object: tag %>

  <div class="flex w-full items-stretch">
    <div class="min-w-0 flex-1">
      <%= f.text_field :name,
                      placeholder: t("tags.form.name.placeholder"),
                      class: "w-full px-2 py-2.5 border border-mist-200 rounded focus:border-2 focus:border-mist-400" %>
    </div>

    <div class="ml-2 flex shrink-0 items-center gap-2">
      <%= f.submit t("common.update"),
                  class: "px-4 py-2 text-xs text-white bg-mist-500 hover:bg-mist-600 rounded-xl" %>

      <%= link_to t("common.cancel"),
                  tags_path,
                  class: "px-1.5 py-2 text-xs text-mist-500 hover:text-mist-700 border border-mist-200 rounded-xl" %>
    </div>
  </div>
<% end %>
