<%= form_with model: tag, class: "rounded-3xl border border-mist-100 bg-white p-5 shadow-sm hover:border-mist-200 hover:bg-mist-50" do |f| %>
  <div class="flex w-full">
    <div class="min-w-0 flex-1">
      <%= f.text_field :name, placeholder: t("tags.form.name.placeholder"), class: "w-full px-4 py-3 border border-mist-200 rounded focus:border-2 focus:border-mist-400" %>
    </div>

    <%= f.submit class: "shrink-0 text-sm ml-2 px-4 text-white bg-mist-500 hover:bg-mist-600 rounded-xl" %>
  </div>
<% end %>
