<%= form_with model: tag, class: "card min-h-16 px-4 py-3 md:px-6 space-y-2" do |f| %>
  <%= render "shared/error_messages", object: tag %>

  <div class="flex items-center justify-between gap-3">
    <%= f.text_field :name,
                    placeholder: t("tags.form.name.placeholder"),
                    class: "form-control w-full px-2 py-1.5" %>

    <div class="flex shrink-0 items-center gap-2">
      <%= f.submit t("common.update"), class: "btn-primary px-3 py-1.5 text-sm" %>

      <%= link_to t("common.cancel"), tags_path, class: "btn-secondary px-1.5 py-1.5 text-sm" %>
    </div>
  </div>
<% end %>
