<%= turbo_frame_tag tag, class: "block" do %>
  <div class="card flex min-h-16 items-center justify-between gap-3 px-6 py-3 md:px-8">
    <div class="min-w-0 flex-1 truncate">
      <%= tag.name %>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <%= link_to edit_tag_path(tag),
                  class: "btn-secondary flex items-center gap-1.5 px-2 py-1",
                  aria: { label: t("common.edit") } do %>
        <span class="material-symbols-rounded" aria-hidden="true">edit</span>
        <span class="hidden md:inline"><%= t("common.edit") %></span>
      <% end %>

      <div data-controller="modal">
        <button
          type="button"
          data-action="modal#open"
          class="btn-danger flex items-center gap-1.5 px-2 py-1"
          aria-label="<%= t("common.delete") %>"
        >
          <span class="material-symbols-rounded" aria-hidden="true">delete</span>
          <span class="hidden md:inline"><%= t("common.delete") %></span>
        </button>

        <%= render "shared/delete_confirmation_dialog",
                    title: t("tags.tag.delete_confirmation", tag_name: tag.name),
                    message: "",
                    action_text: t("common.delete_action"),
                    delete_path: tag_path(tag),
                    form_data: { turbo_frame: "_top" } # 削除時はページ全体を遷移対象とする
        %>
      </div>
    </div>
  </div>
<% end %>
