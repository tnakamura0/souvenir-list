<div class="bg-white hover:bg-mist-50 rounded-3xl border border-mist-100 hover:border-mist-200 shadow-sm p-5 flex items-center justify-between">
  <div class="truncate">
    <%= tag.name %>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to t("common.edit"), edit_tag_path(tag), class: "text-xs text-mist-400 hover:text-mist-700 px-3 py-1.5 border border-mist-200 rounded-xl" %>
    <%= button_to t("common.delete"), tag_path(tag), method: :delete, data: { turbo_confirm: t("tags.tag.delete_confirmation", tag_name: tag.name) }, class: "text-xs text-red-400 hover:text-red-600 px-3 py-1.5 border border-red-100 rounded-xl" %>
  </div>
</div>
