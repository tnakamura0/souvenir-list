<nav class="md:hidden fixed bottom-0 inset-x-0 z-20 bg-surface border-t border-border">
  <div class="flex h-16">
    <%= link_to trips_path,
          class: class_names("flex flex-1 flex-col items-center justify-center gap-0.5",
            "text-primary" => navigation_active?(:trips),
            "text-text-secondary" => !navigation_active?(:trips)
          ) do %>
      <span class="material-symbols-rounded" aria-hidden="true">travel</span>
      <span class="text-xs font-medium"><%= t(".trips") %></span>
    <% end %>

    <%= link_to root_path,
          class: class_names("flex flex-1 flex-col items-center justify-center gap-0.5",
            "text-primary" => navigation_active?(:today),
            "text-text-secondary" => !navigation_active?(:today)
          ) do %>
      <span class="material-symbols-rounded" aria-hidden="true">today</span>
      <span class="text-xs font-medium"><%= t(".today") %></span>
    <% end %>

    <%= link_to recipients_path,
          class: class_names("flex flex-1 flex-col items-center justify-center gap-0.5",
            "text-primary" => navigation_active?(:recipients),
            "text-text-secondary" => !navigation_active?(:recipients)
          ) do %>
      <span class="material-symbols-rounded" aria-hidden="true">emoji_people</span>
      <span class="text-xs font-medium"><%= t(".recipients") %></span>
    <% end %>
  </div>
</nav>
