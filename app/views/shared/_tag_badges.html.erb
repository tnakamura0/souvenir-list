<% if recipient.tags.any? %>
  <div class="<%= class_names(
    "flex flex-wrap gap-1.5",
    local_assigns[:class]
  ) %>">
    <% recipient.tags.each do |tag| %>
      <span class="
        inline-flex items-center rounded-full
        border border-mist-200 bg-mist-50
        px-2 py-0.5 text-xs text-mist-600
      ">
        <%= tag.name %>
      </span>
    <% end %>
  </div>
<% end %>
