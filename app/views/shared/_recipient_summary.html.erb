<div class="min-w-0">
  <%# 名前・グループバッジ %>
  <div class="flex min-w-0 flex-wrap items-center gap-2">
    <span class="min-w-0 truncate font-medium text-mist-900">
      <%= recipient.name %>
    </span>

    <% if recipient.kind_group? %>
      <span class="
        shrink-0 rounded-full bg-mist-100
        px-2 py-0.5 text-xs text-mist-700
      ">
        <%= t(
              "recipients.recipient.group_badge",
              people_count: recipient.people_count
            ) %>
      </span>
    <% end %>
  </div>

  <%# タグ %>
  <%= render(
        "shared/tag_badges",
        recipient: recipient,
        class: "mt-2"
      ) %>

  <%# メモ %>
  <% if local_assigns.fetch(:show_memo, true) && recipient.memo.present? %>
    <p class="mt-2 truncate text-xs text-mist-400">
      <%= recipient.memo %>
    </p>
  <% end %>
</div>
