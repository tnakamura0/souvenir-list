<div class="min-w-0">
  <%# 名前・グループバッジ %>
  <div class="flex min-w-0 flex-wrap items-center gap-2">
    <% if show_link %>
      <%= link_to recipient_path(recipient), class: "flex min-w-0 items-center gap-1 hover:text-primary" do %>
        <span class="min-w-0 truncate font-medium"><%= recipient.name %></span>
        <span class="material-symbols-rounded shrink-0" aria-hidden="true">chevron_right</span>
      <% end %>
    <% else %>
      <span class="min-w-0 truncate font-medium"><%= recipient.name %></span>
    <% end %>

    <% if recipient.kind_group? %>
      <span class="
        shrink-0 rounded-full border border-border bg-background 
        px-2 py-0.5 text-xs font-medium text-text-secondary
      ">
        <%= t("recipients.recipient.group_badge", people_count: recipient.people_count) %>
      </span>
    <% end %>
  </div>

  <%# タグ %>
  <%= render("shared/tag_badges", recipient: recipient) %>

  <%# メモ %>
  <% if show_memo && recipient.memo.present? %>
    <p class="mt-2 truncate text-sm text-text-secondary"><%= recipient.memo %></p>
  <% end %>
</div>
