<header class="bg-surface shadow-sm sticky top-0 z-10">
  <div class="px-4 py-3 flex items-center justify-between">
    <%= link_to "おみやげリスト", root_path, class: "text-navy-600 font-bold text-lg" %>

    <% if logged_in? %>
      <%= button_to logout_path,
                    method: :delete,
                    aria: { label: t(".logout") },
                    class: "md:hidden p-2 text-text-secondary" do %>
        <span class="material-symbols-rounded">logout</span>
      <% end %>
    <% end %>
  </div>
</header>
