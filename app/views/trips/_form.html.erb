<%= form_with model: @trip, class: "space-y-5" do |f| %>
  <p class="mb-2 text-sm text-text-muted"><%= t("common.required_notice") %></p>

  <%= render "shared/error_messages", object: f.object %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, placeholder: t("trips.form.name.placeholder"), class: "form-control #{'input-error' if @trip.errors[:name].present?}" %>
  </div>

  <div>
    <%= f.label :destination, class: "label" %>
    <%= f.text_field :destination, placeholder: t("trips.form.destination.placeholder"), class: "form-control #{'input-error' if @trip.errors[:destination].present?}" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="min-w-0">
      <%= f.label :departure_date, class: "label" %>
      <%= f.date_field :departure_date, class: "date #{'input-error' if @trip.errors[:departure_date].present?}" %>
    </div>

    <div class="min-w-0">
      <%= f.label :return_date, class: "label" %>
      <%= f.date_field :return_date, class: "date #{'input-error' if @trip.errors[:return_date].present?}" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <%= link_to t("common.cancel"), cancel_path, class: "btn-secondary py-3 text-center" %>
    <%= f.submit class: "btn-primary py-3" %>
  </div>
<% end %>
