<div class="card card-hover">
  <%= link_to trip_path(trip), class: "block px-5 py-4" do %>
    <div class="min-w-0 space-y-1">
      <h2 class="truncate text-lg font-semibold"><%= trip.name %></h2>
      <p class="flex items-center gap-1 text-text-secondary">
        <span class="material-symbols-rounded text-base">location_on</span>
        <span class="truncate"><%= trip.destination %></span>
      </p>

      <div class="flex items-center gap-1.5 text-text-secondary">
        <span class="material-symbols-rounded">calendar_today</span>
        <span>
          <%= trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= trip.return_date.strftime("%Y/%-m/%-d") %>
        </span>
      </div>
    </div>
  <% end %>
</div>
