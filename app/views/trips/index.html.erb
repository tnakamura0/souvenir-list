<div class="flex items-center justify-between mb-6">
  <h1 class="page-title"><%= t(".title") %></h1>
  <%= link_to new_trip_path, class: "btn-secondary flex items-center gap-2" do %>
    <span class="material-symbols-rounded">add</span>
    <span><%= t(".new_trip") %></span>
  <% end %>
</div>

<% if @trips.present? %>
  <div class="space-y-3">
    <%= render @trips %>
  </div>
<% else %>
  <div class="card px-6 py-12 text-center">
    <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-2xl bg-primary-soft text-primary">
      <span class="material-symbols-rounded text-2xl">travel_luggage_and_bags</span>
    </div>
    <p class="mb-2 font-semibold"><%= t(".empty.title") %></p>
    <p class="mx-auto mb-6 max-w-sm text-sm text-text-secondary">
      <%= t(".empty.description") %>
    </p>
    <%= link_to new_trip_path, class: "btn-primary inline-flex items-center gap-2 px-6 py-3" do %>
      <span class="material-symbols-rounded">add</span>
      <span><%= t(".empty.action") %></span>
    <% end %>
  </div>
<% end %>
