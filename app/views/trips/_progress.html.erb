<% progress_percentage = trip.progress_percentage %>

<div class="mt-5 border-t border-mist-100 pt-4">
  <div class="mb-2 flex items-center justify-between">
    <p class="text-sm font-medium"><%= t("trips.show.progress.title") %></p>

    <p class="text-sm font-semibold"><%= progress_percentage %>%</p>
  </div>

  <div
    class="h-2.5 w-full overflow-hidden rounded-full bg-mist-100"
    role="progressbar"
    aria-label="<%= t("trips.show.progress.title") %>"
    aria-valuenow="<%= progress_percentage %>"
    aria-valuemin="0"
    aria-valuemax="100"
  >
    <div
      class="h-full rounded-full bg-mist-600 transition-all duration-300"
      style="width: <%= progress_percentage %>%"
    ></div>
  </div>

  <div class="mt-2 flex items-center justify-between text-xs text-mist-500">
    <% if progress_percentage == 100 %>
      <p class="font-medium text-mist-700"><%= t("trips.show.progress.completed") %></p>
    <% else %>
      <p>
        <%= t("trips.show.progress.purchased", 
          purchased_count: trip.purchased_count,
          total_count: trip.total_count) %>
      </p>
    <% end %>
  </div>
</div>
