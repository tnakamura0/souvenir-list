<div class="mb-6 flex items-center justify-between">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-mist-400 hover:text-mist-700" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>

  <div class="flex gap-2">
    <%= link_to t("common.edit"), edit_trip_path(@trip), class: "text-xs px-3 py-1.5 border rounded-xl" %>
    <%= button_to t("common.delete"), trip_path(@trip), method: :delete, data: { turbo_confirm: t(".delete_confirmation", trip_name: @trip.name) }, class: "text-xs px-3 py-1.5 border rounded-xl" %>
  </div>
</div>

<div class="mb-4 p-5 rounded-2xl shadow-md">
  <%# 旅行詳細表示 %>
  <div class="flex justify-between">
    <div>
      <h1 class="text-lg font-bold"><%= @trip.name %></h1>
      <p class="text-sm flex items-center gap-1">
        <span class="material-symbols-rounded">location_on</span><%= @trip.destination %>
      </p>
    </div>
    <div class="text-right">
      <span class="text-xs">
        <%= @trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= @trip.return_date.strftime("%Y/%-m/%-d") %>
      </span>
    </div>
  </div>

  <%# 進捗バー %>
  <% if @trip.total_count > 0 %>
    <%= render "progress", trip: @trip %>
  <% end %>
</div>

<%# お土産リスト %>
<%= render "trips/recipient_list", trip: @trip, trip_recipients: @trip_recipients %>
