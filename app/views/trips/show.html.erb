<div class="mb-6">
  <%= link_to trips_path, class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>
</div>

<div class="mb-8">
  <div class="flex items-center justify-between">
    <h1 class="page-header page-title"><%= t(".title") %></h1>

    <%# ケバブメニューと削除ダイアログ %>
    <div
      class="relative"
      data-controller="kebab-menu modal"
      data-action="click@window->kebab-menu#closeOnOutside"
    >
      <button
        type="button"
        class="text-text-muted hover:text-text-primary"
        data-action="click->kebab-menu#toggle"
      >
        <span class="material-symbols-rounded">more_vert</span>

        <span class="sr-only">
          <%= t("common.open_menu") %>
        </span>
      </button>

      <div 
        class="absolute right-0 top-full z-20 mt-1 hidden w-40 rounded-lg border border-border bg-surface p-1 shadow-lg"
        data-kebab-menu-target="menu">
        <%= link_to t("common.edit"),
                    edit_trip_path(@trip),
                    class: "block w-full rounded-md px-3 py-2 hover:bg-surface-hover" %>
      
          <button
            type="button"
            data-action="kebab-menu#close modal#open"
            class="w-full rounded-md px-3 py-2 text-left text-danger hover:bg-danger-soft"
          >
            <%= t("common.delete") %>
          </button>
      </div>

      <%= render "shared/delete_confirmation_dialog",
            title: t(".delete_dialog.title", trip_name: @trip.name),
            message: t(".delete_dialog.message"),
            action_text: t("common.delete_action"),
            delete_path: trip_path(@trip),
            form_data: {} %>
    </div>
  </div>

  <p class="page-description"><%= t(".description") %></p>

  <div class="card mt-5 p-5 md:p-6">
    <%# 旅行詳細表示 %>
    <div class="min-w-0 space-y-1">
      <h2 class="text-xl font-semibold truncate"><%= @trip.name %></h2>
      <p class="flex items-center gap-1 text-sm text-text-secondary">
        <span class="material-symbols-rounded">location_on</span>
        <span class="truncate"><%= @trip.destination %></span>
      </p>

      <div class="flex items-center gap-1.5 text-sm text-text-secondary">
        <span class="material-symbols-rounded">calendar_today</span>
        <span><%= l(@trip.departure_date) %> 〜 <%= l(@trip.return_date) %></span>
      </div>
    </div>

    <%# 進捗バー %>
    <% if @trip.total_count > 0 %>
      <div id="trip_progress">
        <%= render "progress", trip: @trip %>
      </div>
    <% end %>
  </div>
</div>

<%# お土産リスト %>
<%= render "trips/recipient_list", trip: @trip, trip_recipients: @trip_recipients %>
