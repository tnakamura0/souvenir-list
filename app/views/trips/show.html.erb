<div class="mb-6 flex items-center justify-between">
  <%= link_to trips_path, class: "back-link" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>

  <div class="flex gap-2">
    <%= link_to edit_trip_path(@trip), class: "btn-secondary inline-flex items-center gap-1.5 px-3 py-1" do %>
      <span class="material-symbols-rounded text-base" aria-hidden="true">edit</span>
      <span><%= t("common.edit") %></span>
    <% end %>
    <%= button_to trip_path(@trip),
                  method: :delete,
                  data: { turbo_confirm: t(".delete_confirmation", trip_name: @trip.name) },
                  class: "btn-danger inline-flex items-center gap-1.5 px-3 py-1" do %>
      <span class="material-symbols-rounded" aria-hidden="true">delete</span>
      <span><%= t("common.delete") %></span>
    <% end %>
  </div>
</div>

<div class="card mb-4 p-4 md:p-5">
  <%# 旅行詳細表示 %>
  <div class="min-w-0 space-y-1">
    <h1 class="text-lg font-semibold truncate"><%= @trip.name %></h1>
    <p class="flex items-center gap-1 text-sm text-text-secondary">
      <span class="material-symbols-rounded">location_on</span>
      <span class="truncate"><%= @trip.destination %></span>
    </p>

    <div class="flex items-center gap-1.5 text-sm text-text-secondary">
      <span class="material-symbols-rounded">calendar_today</span>
      <span>
        <%= @trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= @trip.return_date.strftime("%Y/%-m/%-d") %>
      </span>
    </div>
  </div>

  <%# 進捗バー %>
  <% if @trip.total_count > 0 %>
    <div id="trip_progress">
      <%= render "progress", trip: @trip %>
    </div>
  <% end %>
</div>

<%# お土産リスト %>
<%= render "trips/recipient_list", trip: @trip, trip_recipients: @trip_recipients %>
