<div class="mb-6 flex items-center justify-between">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-mist-400 hover:text-mist-700" do %>
    <span class="material-symbols-rounded">chevron_left</span>
    <span><%= t("common.back") %></span>
  <% end %>

  <div class="flex gap-2">
    <%= link_to t(".edit"), "#", class: "text-xs px-3 py-1.5 border rounded-xl" %>
    <%= button_to t(".delete"), "#", class: "text-xs px-3 py-1.5 border rounded-xl" %>
  </div>
</div>

<div class="mb-4 p-5 rounded-2xl shadow-md">
  <%# 旅行詳細表示 %>
  <div class="flex justify-between">
    <div>
      <h1 class="text-lg font-bold"><%= @trip.name %></h1>
      <p class="text-sm flex items-center gap-1">
        <span class="material-symbols-rounded">location_on</span><%= @trip.destination %>
      </p>
    </div>
    <div class="text-right">
      <span class="text-xs">
        <%= @trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= @trip.return_date.strftime("%Y/%-m/%-d") %>
      </span>
    </div>
  </div>

  <%# 進捗バー %>
</div>

<%# お土産リスト %>
<div class="flex items-center justify-between mb-3">
  <h2 class="text-lg font-semibold"><%= t(".souvenir_list") %></h2>
  <div class="flex gap-1 px-3 py-1.5 border rounded-xl">
    <span class="material-symbols-rounded">add</span>
    <%= link_to t(".add_recipient"), "#" %>
  </div>
</div>

<div class="text-center py-12 border border-mist-100 rounded-2xl shadow-md">
  <p class="text-sm mb-4"><%= t(".empty.message") %></p>
  <%= button_to t(".empty.action"), "#", class: "px-3 py-2 border rounded-xl" %>
</div>
