<div class="mb-4 flex items-center justify-between">
  <div class="border-l-2 border-primary pl-3">
    <h2 class="text-lg font-semibold tracking-wide"><%= t("trips.recipient_list.title") %></h2>
  </div>

  <%= link_to new_trip_trip_recipient_path(trip),
              class: "btn-secondary flex items-center gap-2 px-4 py-1.5" do %>
    <span class="material-symbols-rounded">group_add</span>
    <span><%= t("trips.recipient_list.add") %></span>
  <% end %>
</div>

<% if trip_recipients.present? %>
  <div class="space-y-3">
    <%= render trip_recipients %>
  </div>
<% else %>
  <div class="card px-3 py-6 text-center">
    <p class="mb-4"><%= t("trips.recipient_list.empty.message") %></p>

    <%= link_to new_trip_trip_recipient_path(trip), class: "btn-primary inline-flex items-center gap-1.5 px-6 py-3" do %>
      <span class="material-symbols-rounded">group_add</span>
      <span><%= t("trips.recipient_list.empty.action") %></span>
    <% end %>
  </div>
<% end %>
