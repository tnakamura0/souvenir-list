<%# 「今日の旅行」がある場合 %>
<% if @trip %>

  <%# 旅行切り替え用UI %>
  <% if @today_trips.size > 1 %>
    <%= form_with url: root_path, method: :get, class: "mb-4" do |f| %>
      <%= f.select :trip_id,
                  options_from_collection_for_select(@today_trips, :id, :name, @trip.id),
                  {},
                  class: "text-text-secondary outline-none hover:text-primary focus-visible:text-primary",
                  onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <div class="card mb-4 p-4 md:p-5">
    <%# 旅行詳細表示 %>
    <div class="min-w-0 space-y-1">
      <div class="mb-2">
        <span class="inline-flex rounded-full bg-accent-soft px-2.5 py-1 text-xs font-medium text-accent">
          <%= t(".today_badge") %>
        </span>
      </div>

      <h1 class="truncate text-lg font-semibold"><%= @trip.name %></h1>
      <p class="flex items-center gap-1 text-sm text-text-secondary">
        <span class="material-symbols-rounded">location_on</span>
        <span class="truncate"><%= @trip.destination %></span>
      </p>

      <div class="flex items-center gap-1.5 text-sm text-text-secondary">
        <span class="material-symbols-rounded">calendar_today</span>
        <span>
          <%= @trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= @trip.return_date.strftime("%Y/%-m/%-d") %>
        </span>
      </div>
    </div>

    <%# 進捗バー %>
    <% if @trip.total_count > 0 %>
      <div id="trip_progress">
        <%= render "trips/progress", trip: @trip %>
      </div>
    <% end %>
  </div>

  <%# お土産リスト %>
  <%= render "trips/recipient_list", trip: @trip, trip_recipients: @trip_recipients %>

<%# 「今日の旅行」がない場合 %>
<% else %>
  <div class="card px-6 py-12 text-center">
    <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-2xl bg-primary-soft text-primary">
      <span class="material-symbols-rounded">travel_luggage_and_bags</span>
    </div>
    <p class="mb-6 text-text-secondary">
      <%= t(".empty.message") %>
    </p>
    <%= link_to new_trip_path, class: "btn-primary inline-flex items-center gap-1" do %>
      <span><%= t(".empty.action") %></span>
      <span class="material-symbols-rounded">chevron_forward</span>
    <% end %>
  </div>
<% end %>
