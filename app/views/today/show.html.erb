<%# 「今日の旅行」がある場合 %>
<% if @trip %>

  <%# 旅行切り替え用UI %>
  <% if @today_trips.size > 1 %>
    <%= form_with url: root_path, method: :get, class: "mb-4" do |f| %>
      <%= f.select :trip_id,
                  options_from_collection_for_select(@today_trips, :id, :name, @trip.id),
                  {},
                  onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <div class="mb-4 p-5 rounded-2xl shadow-md">
    <%# 旅行詳細表示 %>
    <div class="flex justify-between">
      <div>
        <h1 class="text-lg font-bold"><%= @trip.name %></h1>
        <p class="text-sm flex items-center gap-1">
          <span class="material-symbols-rounded">location_on</span><%= @trip.destination %>
        </p>
      </div>
      <div class="text-right">
        <span class="text-xs">
          <%= @trip.departure_date.strftime("%Y/%-m/%-d") %> 〜 <%= @trip.return_date.strftime("%Y/%-m/%-d") %>
        </span>
      </div>
    </div>

    <%# 進捗バー %>
    <% if @trip.total_count > 0 %>
      <%= render "trips/progress", trip: @trip %>
    <% end %>
  </div>

  <%# お土産リスト %>
  <%= render "trips/recipient_list", trip: @trip, trip_recipients: @trip_recipients %>

<%# 「今日の旅行」がない場合 %>
<% else %>
  <p class="mt-18 mb-6 text-center"><%= t(".empty.message") %></p>
  <div class="text-center">
    <%= link_to new_trip_path, class: "inline-flex items-center px-4 py-2 border border-mist-400 rounded-xl hover:text-white hover:bg-mist-400" do %>
      <%= t(".empty.action") %>
      <span class="material-symbols-rounded">chevron_forward</span>
    <% end %>
  </div>
<% end %>
